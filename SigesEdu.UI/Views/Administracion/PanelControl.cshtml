@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color: #4E342E;"><i class="bi bi-hdd-network"></i> Panel de Administración del Sistema</h2>
        <span class="badge bg-danger text-white fs-6"><i class="bi bi-shield-lock-fill"></i> Nivel de Acceso: ROOT</span>
    </div>
    <hr style="border-color: #8D6E63;" />
    <!-- Bloque de Alertas (Éxito y Error) -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <!-- SALIDAS: Métricas de desempeño y alertas de integridad (Documentado en RF/Salidas) -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center h-100" style="border-color: #D7CCC8; background-color: #FDFBF7;">
                <div class="card-body">
                    <h6 style="color: #5D4037;"><i class="bi bi-activity"></i> Estado del Sistema</h6>
                    <h4 class="text-success mt-2">Óptimo</h4>
                    <small class="text-muted">Uptime: 99.9%</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100" style="border-color: #D7CCC8; background-color: #FDFBF7;">
                <div class="card-body">
                    <h6 style="color: #5D4037;"><i class="bi bi-database"></i> Motor SQLite (WAL)</h6>
                    <h4 class="text-dark mt-2">14.2 MB</h4>
                    <small class="text-muted">Último backup: Hace 2 horas</small>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100" style="border-color: #F5C2C7; background-color: #F8D7DA;">
                <div class="card-body">
                    <h6 class="text-danger fw-bold"><i class="bi bi-exclamation-triangle"></i> Alertas de Integridad de Datos</h6>
                    <ul class="mb-0 text-danger" style="font-size: 0.85rem;">
                        <li>[Advertencia] 2 usuarios (Padres) no han verificado su correo electrónico.</li>
                        <li>[Limpio] Cadenas SHA-256 de actas verificadas correctamente.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- ENTRADA: Configuración del Ciclo Escolar Activo -->
        <div class="col-md-5 mb-4">
            <div class="card h-100" style="border-color: #D7CCC8;">
                <div class="card-header text-white" style="background-color: #6D4C41;">
                    <i class="bi bi-calendar-event"></i> Configuración del Ciclo Escolar
                </div>
                <div class="card-body" style="background-color: #FDFBF7;">
                    <form>
                        <div class="mb-3">
                            <label class="form-label" style="color: #5D4037;">Año Lectivo Activo</label>
                            <input type="number" class="form-control" value="2026" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" style="color: #5D4037;">Apertura del Sistema</label>
                                <input type="date" class="form-control" value="2026-01-15" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" style="color: #5D4037;">Cierre del Sistema</label>
                                <input type="date" class="form-control" value="2026-11-30" required>
                            </div>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="mantenimiento">
                            <label class="form-check-label text-danger fw-bold" for="mantenimiento">Activar Modo Mantenimiento</label>
                        </div>
                        <button type="button" class="btn w-100 text-white" style="background-color: #5D4037;">Aplicar Configuración</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ENTRADA: Administración de Credenciales y Respaldos -->
        <div class="col-md-7 mb-4">
            <!-- Gestión de Roles (RBAC) -->
            <div class="card mb-3" style="border-color: #D7CCC8;">
                <div class="card-header text-white" style="background-color: #6D4C41;">
                    <i class="bi bi-people"></i> Administración de Credenciales y Roles (RBAC)
                </div>
                <div class="card-body p-3" style="background-color: #FDFBF7;">
                    <form method="get" asp-controller="Administracion" asp-action="PanelControl" class="d-flex justify-content-between align-items-center mb-3">
                    <!-- Barra de búsqueda con su botón de lupa -->
                    <div class="input-group w-50">
                        <input type="text" name="searchString" class="form-control" placeholder="Buscar usuario (Username, Rol)..." value="@ViewBag.CurrentSearch">
                        <button type="submit" class="btn btn-outline-secondary" style="border-color: #ced4da;">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    
                    <!-- Botón que abre el modal, ubicado a la derecha en lugar del botón amarillo -->
                    <button type="button" class="btn btn-outline-primary" style="color: #4E342E; border-color: #4E342E;" data-bs-toggle="modal" data-bs-target="#modalNuevoUsuario">
                        <i class="bi bi-person-plus"></i> Nuevo Usuario
                    </button>
                </form>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped text-center align-middle" style="font-size: 0.85rem;">
                            <thead style="background-color: #EFEBE9; color: #4E342E;">
                                <tr>
                                    <th>Usuario</th>
                                    <th>Rol Asignado</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            <tbody>
                                @if (ViewBag.Usuarios != null)
                                {
                                    foreach (var usr in ViewBag.Usuarios)
                                    {
                                        <tr>
                                            <td class="text-start">@usr.Usuario</td>
                                            <td>
                                                @if (usr.Rol == "Coordinador")
                                                {
                                                    <span class="badge bg-primary">Coordinador</span>
                                                }
                                                else if (usr.Rol == "Docente")
                                                {
                                                    <span class="badge bg-info text-dark">Docente</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@usr.Rol</span>
                                                }
                                            </td>
                                            <td><span class="badge bg-success">@usr.Estado</span></td>
                                            <td><button class="btn btn-sm btn-outline-secondary"><i class="bi bi-key"></i> Reset</button></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Ejecución de copias de seguridad y depuración -->
            <div class="card" style="border-color: #D7CCC8;">
                <div class="card-header text-white" style="background-color: #6D4C41;">
                    <i class="bi bi-tools"></i> Mantenimiento Técnico y Backups
                </div>
                <div class="card-body p-3 d-flex justify-content-between align-items-center" style="background-color: #FDFBF7;">
                    <div>
                        <h6 class="mb-1" style="color: #5D4037;">Respaldo de Base de Datos</h6>
                        <small class="text-muted">Genera un volcado completo de SigesEdu.db (.sql / .bak)</small>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-outline-danger me-2"><i class="bi bi-trash"></i> Depuración Técnica</button>
                        <button class="btn btn-sm text-white" style="background-color: #198754;"><i class="bi bi-cloud-download"></i> Ejecutar Backup Local</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SALIDA: Bitácoras de auditoría global -->
    <div class="card mb-4" style="border-color: #D7CCC8;">
        <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #4E342E;">
            <span><i class="bi bi-journal-code"></i> Bitácora de Auditoría de Modificaciones Críticas</span>
            <button class="btn btn-sm btn-light"><i class="bi bi-download"></i> Exportar Log</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                <table class="table table-striped table-hover mb-0" style="font-size: 0.85rem; font-family: monospace;">
                    <thead style="background-color: #EFEBE9; color: #4E342E; position: sticky; top: 0;">
                        <tr>
                            <th>Timestamp</th>
                            <th>Usuario (Rol)</th>
                            <th>Módulo Afectado</th>
                            <th>Acción Registrada</th>
                            <th>Dirección IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Bitacora != null)
                        {
                            foreach (var log in ViewBag.Bitacora)
                            {
                                <tr>
                                    <td>@log.Timestamp</td>
                                    <td>@log.Usuario</td>
                                    <td>@log.Modulo</td>
                                    <td>@log.Accion</td>
                                    <td>@log.IP</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- Modal Nuevo Usuario Administrativo -->
    <div class="modal fade" id="modalNuevoUsuario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Administracion" asp-action="CrearUsuario" method="post">
                    <div class="modal-header" style="background-color: #6D4C41; color: white;">
                        <h5 class="modal-title"><i class="bi bi-person-plus"></i> Registrar Nuevo Usuario</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" style="background-color: #FDFBF7;">
                        <div class="mb-3">
                            <label class="form-label" style="color: #5D4037;">Nombre de Usuario (Username)</label>
                            <input type="text" name="username" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: #5D4037;">Rol Asignado</label>
                            <select name="rol" class="form-select" required>
                                <option value="">Seleccione un rol...</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Coordinador">Coordinador</option>
                                <option value="Tesorero">Tesorero</option>
                                <option value="Docente">Docente</option>
                            </select>
                            <div class="form-text text-muted">Nota: Los roles de Estudiante y Padre se asignan automáticamente desde Admisiones.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: #5D4037;">Contraseña de Acceso</label>
                            <input type="password" name="password" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn text-white" style="background-color: #5D4037;">Guardar Usuario</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>