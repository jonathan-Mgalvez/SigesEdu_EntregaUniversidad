@{
    ViewData["Title"] = "Estado de Cuenta Escolar";
}

<div class="container mt-4">
    <h2 style="color: #4E342E;">Estado de Cuenta y Solvencia</h2>
    <hr style="border-color: #8D6E63;" />

    @if (ViewBag.TieneEstudiante != null && ViewBag.TieneEstudiante == true)
    {
        <!-- Datos del Estudiante (DINÁMICO DESDE SQLITE) -->
        <div class="card mb-4" style="border-color: #D7CCC8;">
            <div class="card-body" style="background-color: #FDFBF7;">
                <div class="row">
                    <div class="col-md-6">
                        <h5 style="color: #6D4C41;">Alumno: <span class="text-dark fw-bold">@ViewBag.Alumno</span></h5>
                        <p class="mb-1 text-muted">Documento (CUI): @ViewBag.Carne</p>
                        <p class="mb-0 text-muted">Grado: @ViewBag.GradoSeccion</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <h5 style="color: #6D4C41;">Estado Actual: 
                            <span class="badge bg-success">@ViewBag.EstadoActual</span>
                        </h5>
                        <p class="mb-0 text-muted">Tutor Responsable: @ViewBag.Tutor</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resumen Financiero -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-center" style="border-color: #D7CCC8; background-color: #FDFBF7;">
                    <div class="card-body">
                        <h6 style="color: #5D4037;">Cargos Devengados</h6>
                        <h3 class="text-danger">Q. @ViewBag.CargosDevengados</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center" style="border-color: #D7CCC8; background-color: #FDFBF7;">
                    <div class="card-body">
                        <h6 style="color: #5D4037;">Total Pagado</h6>
                        <h3 class="text-success">Q. @ViewBag.TotalPagado</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center" style="border-color: #D7CCC8; background-color: #FDFBF7;">
                    <div class="card-body">
                        <h6 style="color: #5D4037;">Saldo Pendiente</h6>
                        <h3 class="text-dark">Q. @ViewBag.SaldoPendiente</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Historial de Movimientos -->
        <div class="card" style="border-color: #D7CCC8;">
            <div class="card-header text-white" style="background-color: #6D4C41;">Historial de Movimientos</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead style="background-color: #EFEBE9; color: #4E342E;">
                            <tr>
                                <th>Fecha</th>
                                <th>Concepto</th>
                                <th>No. Boleta/Recibo</th>
                                <th>Cargo</th>
                                <th>Abono</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@DateTime.Now.ToString("dd/MM/yyyy")</td>
                                <td>Inscripción Anual 2026</td>
                                <td>REC-2026-000124</td>
                                <td>Q. 850.00</td>
                                <td>Q. 850.00</td>
                                <td><span class="badge bg-success">Aplicado</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ESTADO VACÍO: Cuando es primer ingreso -->
        <div class="alert alert-warning text-center mt-5" style="background-color: #FDFBF7; border-color: #D7CCC8; color: #5D4037;">
            <h4 class="alert-heading"><i class="bi bi-info-circle"></i> Aún no tiene estudiantes inscritos</h4>
            <p>Parece que es su primera vez en el sistema o aún no ha registrado a ningún estudiante.</p>
            <hr style="border-color: #8D6E63;">
            <p class="mb-0">
                Por favor, diríjase al módulo de <strong>Nueva Matrícula</strong> en la barra superior para iniciar una solicitud y cargar sus legajos digitales.
            </p>
        </div>
    }
</div>