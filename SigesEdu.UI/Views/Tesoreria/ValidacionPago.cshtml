@{
    ViewData["Title"] = "Bandeja de Tesorería";
}

<div class="container mt-4">
    <h2 style="color: #4E342E;">Gestión Financiera > Bandeja de Tesorería y Validación</h2>
    <hr style="border-color: #8D6E63;" />

    @if (TempData["MensajeError"] != null || ViewBag.MensajeError != null)
    {
        <div class="alert alert-danger">@(TempData["MensajeError"] ?? ViewBag.MensajeError)</div>
    }
    @if (TempData["MensajeExito"] != null || ViewBag.MensajeExito != null)
    {
        <div class="alert alert-success">@(TempData["MensajeExito"] ?? ViewBag.MensajeExito)</div>
    }

    <!-- ======================================================= -->
    <!-- PARTE 1: SALIDAS (Reportes y Cola de Trabajo según Doc) -->
    <!-- ======================================================= -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center" style="border-color: #D7CCC8; background-color: #FDFBF7;">
                <div class="card-body">
                    <h6 style="color: #5D4037;"><i class="bi bi-clock-history"></i> En Espera de Verificación</h6>
                    <h3 class="text-primary">@ViewBag.TotalPendientes Solicitud(es)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center" style="border-color: #D7CCC8; background-color: #FDFBF7;">
                <div class="card-body">
                    <h6 style="color: #5D4037;"><i class="bi bi-cash-stack"></i> Recaudación Consolidada</h6>
                    <h3 class="text-success">Q. @ViewBag.Recaudacion</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center" style="border-color: #D7CCC8; background-color: #FDFBF7;">
                <div class="card-body">
                    <h6 style="color: #5D4037;"><i class="bi bi-exclamation-octagon"></i> Padrón de Morosidad</h6>
                    <h3 class="text-danger">@ViewBag.Morosidad Alumno(s)</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-5" style="border-color: #D7CCC8;">
        <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #6D4C41;">
            <span><i class="bi bi-list-check"></i> Cola de Comprobantes Pendientes</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle text-center" style="font-size: 0.9rem;">
                    <thead style="background-color: #EFEBE9; color: #4E342E;">
                        <tr>
                            <th>Fecha</th>
                            <th class="text-start">Estudiante / Carné</th>
                            <th>Concepto</th>
                            <th>Monto Reportado</th>
                            <th>Expira en</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.SolicitudesPendientes != null)
                        {
                            bool hayPendientes = false;
                            foreach (var solicitud in ViewBag.SolicitudesPendientes)
                            {
                                hayPendientes = true;
                                bool isActiva = ViewBag.SolicitudIdActiva != null && ViewBag.SolicitudIdActiva == solicitud.SolicitudId;
                                <tr style="@(isActiva ? "background-color: #FFF3E0;" : "")">
                                    <td>@DateTime.Now.ToString("dd/MM/yyyy")</td>
                                    <td class="text-start @(isActiva ? "fw-bold" : "")">@solicitud.Estudiante</td>
                                    <td>Inscripción Anual</td>
                                    <td>Q. 850.00</td>
                                    <td class="@(isActiva ? "text-danger fw-bold" : "")">14h 22m</td>
                                    <td>
                                        @if (isActiva)
                                        {
                                            <button class="btn btn-sm btn-secondary disabled">Validando...</button>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("ValidacionPago", "Tesoreria", new { solicitudId = solicitud.SolicitudId })" class="btn btn-sm btn-outline-primary" style="color: #4E342E; border-color: #4E342E;">Revisar</a>
                                        }
                                    </td>
                                </tr>
                            }
                            
                            if (!hayPendientes)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No hay solicitudes pendientes en la cola.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ======================================================= -->
    <!-- PARTE 2: ENTRADAS (Detalle dinámico de la validación)   -->
    <!-- ======================================================= -->
    <h4 class="mt-2 mb-3" style="color: #4E342E;"><i class="bi bi-search"></i> Detalle de Validación Activa</h4>
    
    @if (ViewBag.SolicitudIdActiva != null && ViewBag.SolicitudIdActiva > 0)
    {
        <div class="card mb-4" style="border-color: #D7CCC8;">
            <div class="card-header text-white" style="background-color: #8D6E63;">
                <strong>DATOS DE LA SOLICITUD Y RESERVA</strong>
            </div>
            <div class="card-body" style="background-color: #FDFBF7; color: #5D4037;">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Estudiante:</strong> @ViewBag.Estudiante</p>
                        <p><strong>Arancel Requerido:</strong> Q. @ViewBag.MontoDepositado (Inscripción Anual)</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Grado:</strong> @ViewBag.Grado</p>
                        <p class="text-danger"><strong>Reserva Expira en:</strong> 14 horas 22 minutos (RN-01 Activa)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- MOVIMOS EL FORMULARIO HACIA ARRIBA PARA QUE ABARQUE EL COMPROBANTE Y EL DICTAMEN -->
        <form asp-controller="Tesoreria" asp-action="ProcesarDictamen" method="post">
            <input type="hidden" name="solicitudId" value="@ViewBag.SolicitudIdActiva" />
            
            <div class="card mb-4" style="border-color: #D7CCC8;">
                <div class="card-header text-white" style="background-color: #6D4C41;">
                    <strong>INFORMACIÓN DEL COMPROBANTE CARGADO</strong>
                </div>
                <div class="card-body" style="background-color: #FDFBF7; color: #5D4037;">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <p><strong>Banco Emisor:</strong> <span class="text-muted fst-italic">@ViewBag.BancoEmisor</span></p>
                            <p><strong>Monto Registrado:</strong> Q. @ViewBag.MontoDepositado</p>
                            
                            <!-- Botón para ver imagen -->
                            <a href="@Url.Action("VerBoleta", "Tesoreria", new { nombreArchivo = ViewBag.BoletaPago })" target="_blank" class="btn btn-secondary btn-sm mt-2 mb-3">
                                <i class="bi bi-image"></i> Ver Imagen Boleta de Solvencia
                            </a>
                            
                            <!-- NUEVA CASILLA DE CONFIRMACIÓN DE REVISIÓN VISUAL -->
                            <div class="form-check">
                                <input class="form-check-input border-primary" type="checkbox" id="boletaRevisada" name="boletaRevisada" required>
                                <label class="form-check-label fw-bold text-primary" for="boletaRevisada">
                                    Confirmo que he visualizado y revisado la boleta adjunta
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Código de Seguimiento:</strong> @ViewBag.NumeroTransaccion</p>
                            <p><strong>Fecha Depósito:</strong> <span class="text-muted fst-italic">@ViewBag.FechaDeposito</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4" style="border-color: #D7CCC8;">
                <div class="card-header text-white" style="background-color: #5D4037;">
                    <strong>DICTAMEN FINANCIERO</strong>
                </div>
                <div class="card-body" style="background-color: #FDFBF7; color: #5D4037;">
                    <div class="form-check mb-3">
                        <input class="form-check-input border-secondary" type="checkbox" id="verificacion" required>
                        <label class="form-check-label fw-bold" for="verificacion">
                            Transacción verificada en extracto bancario institucional
                        </label>
                    </div>
                    <div class="mb-3">
                        <label>Observaciones / Motivo de Rechazo:</label>
                        <input type="text" name="observaciones" class="form-control" placeholder="Ej. Pago conforme en cuenta monetaria #001-2948-22" />
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" name="dictamen" value="Rechazar" class="btn text-white fw-bold" style="background-color: #D32F2F;" formnovalidate>
                            <i class="bi bi-x-circle"></i> Rechazar Pago (Abrir FE-03)
                        </button>
                        <button type="submit" name="dictamen" value="Confirmar" class="btn text-white fw-bold" style="background-color: #198754;">
                            <i class="bi bi-check-circle"></i> Confirmar Pago y Activar Matrícula (RN-04)
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="alert text-center" style="background-color: #FFF3E0; border-color: #FFE0B2; color: #E65100;">
                <small><i class="bi bi-exclamation-triangle-fill"></i> ADVERTENCIA: La activación ejecuta una transacción ACID. Consolida estado de matrícula en BD.</small>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-info text-center mt-4 p-5" style="background-color: #FDFBF7; border-color: #D7CCC8;">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
            <h4 class="mt-3" style="color: #4E342E;">¡Excelente! No hay validaciones pendientes</h4>
            <p class="text-muted">Todas las solicitudes han sido procesadas o la cola está vacía.</p>
        </div>
    }
</div>